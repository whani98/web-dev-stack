<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.upload.mapper.BoardMapper">

<resultMap id="boardMap" type="Board">
    <id column="no" property="no"/>
    <result column="title" property="title"/>
    <result column="content" property="content"/>
    <result column="url" property="url"/>
    <result column="created_at" property="createdAt"/>
</resultMap>

<insert id="boardAdd" parameterType="Board" useGeneratedKeys="true" keyProperty="no" keyColumn="no">
INSERT INTO board(title, content, url) 
VALUES(#{title}, #{content}, #{url})
</insert>

<select id="boardAll" resultMap="boardMap">
SELECT * FROM board
</select>

<select id="boardSearch" parameterType="int" resultMap="boardMap">
SELECT * FROM board WHERE no = #{no}
</select>

<update id="boardUpdate" parameterType="BoardDTO">
UPDATE board
SET title = #{title}, content=#{content}, url=#{url}
WHERE no = #{no}
</update>

<delete id="boardDelete" parameterType="int">
DELETE FROM board
WHERE no = #{no}
</delete>

</mapper>