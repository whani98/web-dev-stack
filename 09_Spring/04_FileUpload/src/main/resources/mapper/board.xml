<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.upload.mapper.BoardMapper">
<resultMap id="board" type="board">
    <id column="no" property="no"/>
    <result column="title" property="title"/>
    <result column="content" property="content"/>
    <result column="url" property="url"/>
    <result column="create_at" property="createAt"/>
</resultMap>

<insert id="boardAdd" parameterType="board">
INSERT INTO board(title, content, url) VALUES(#{title}, #{content}, #{url})
</insert>

<select id="boardAll" resultMap="board">
SELECT * FROM board
</select>

<delete id="boardDelete">
DELETE FROM board
WHERE title = #{title}
</delete>

<select id="boardSearch">
SELECT * FROM board FROM title = #{title}
</select>

<update id="boardUpdate" parameterType="Board">
UPDATE board
SET title = #{title}
WHERE title = #{title}
</update>



</mapper>