<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<script>
	function send(f) {
		// 유효성 체크
		let deptno = f.deptNo.value;
		let patt = /^[0-9]*$/;
		if (!patt.test(deptno)) {
			alert("부서번호는 정수로 입력하세요");
			return;
		} else if(deptno == "") {
			alert("부서번호를 입력하세요");
			return;
		}
		let dName = f.dName.value;
		if (dName == "") {
			alert("부서명을 입력하세요");
			return;
		}
		let loc = f.loc.value;
		if (loc == "") {
			alert("위치를 입력하세요");
			return;
		}

		f.action = 'dept_register.do';
		f.submit();
	}
</script>
</head>
<body>
	<form>
		<table border="1">
			<tr>
				<th>부서번호</th>
				<td><input name="deptNo" /></td>
			</tr>
			<tr>
				<th>부서이름</th>
				<td><input name="dName" /></td>
			</tr>
			<th>위치</th>
			<td><input name="loc" /></td>
			</tr>
			<tr>
				<td colspan="2"><input type="button" value="확인" onClick="send(this.form);" /></td>
			</tr>
		</table>
	</form>
</body>
</html>