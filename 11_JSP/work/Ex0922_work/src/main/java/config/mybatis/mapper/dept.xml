<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="d">

<!-- DAO에서 sqlSession.selectList("s.sj_list");의 점 앞의 s와 일치해야함-->
<!-- select만 resultType이 존재 -->
<select id="dept_list" resultType="vo.DeptVO">
SELECT * FROM dept
</select>

<insert id="dept_insert" parameterType="vo.DeptVO">
INSERT INTO dept VALUES(#{deptNo}, #{dName}, #{loc})
</insert>

<delete id="dept_del" parameterType="int">
DELETE FROM dept WHERE deptno = #{deptNo}
</delete>

<select id="dept_update_one" resultType="vo.DeptVO" parameterType="int">
SELECT * FROM dept WHERE deptno = #{deptNo}
</select>

<update id="dept_update" parameterType="java.util.Map">
UPDATE dept SET deptno=#{deptNo}, dname=#{dName}, loc=#{loc} WHERE deptno=#{ori_deptNo}
</update>

</mapper>












