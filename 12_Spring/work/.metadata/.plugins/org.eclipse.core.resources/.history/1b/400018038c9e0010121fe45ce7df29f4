<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="v">
	<!-- 방명록 리스트 -->
	<select id="visit_list" resultType="vst">
		select * from visit order by idx desc
	</select>
	
	<!-- 방명록 추가 -->
	<insert id="visit_insert" parameterType="vst">
		insert into visit values (seq_visit_idx.nextVal, #{name}, #{content}, #{pwd}, #{ip}, sysdate)
	</insert>
	
	<!-- 방명록 삭제 -->
	<delete id="visit_delete" parameterType="vst">
		delete from visit where idx = #{idx}
	</delete>
	
	<!-- 수정할 방명록 조회 -->
	<select id="visit_selectOne" parameterType="int" resultType="vst">
		select * from visit where idx = #{idx}
	</select>
	
	<!-- 방명록 수정 -->
	<update id="visit_update" parameterType="vst">
		update visit set name = #{name}, content = #{content}, pwd = #{pwd}, regdate = sysdate where idx=#{idx}
	</update>
	
	<!-- 비밀번호 확인 -->
	<select id="pwd_check" parameterType="vst" resultType="vst">
		select * from visit where idx =#{idx} and pwd = #{pwd}
	</select>
</mapper>












