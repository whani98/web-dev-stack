package controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.validation.BindingResult;
import org.springframework.web.bind.annotation.RequestMapping;

import dao.CartDAO;
import vo.CartVO;

@Controller
public class CartController {

	CartDAO cart_dao;

	public void setCart_dao(CartDAO cart_dao) {
		this.cart_dao = cart_dao;
	}

	// 회원별 장바구니 조회
	@RequestMapping("cart_list.do")
	public String select(int m_idx, Model model) {

		List<CartVO> list = cart_dao.select(m_idx);
		int total = cart_dao.selectTotalAmount(m_idx);

		// 바인딩
		model.addAttribute("list", list);
		model.addAttribute("total", total);

		return "cart_list";// 포워딩
	}

	// 장바구니 상품 삭제
	@RequestMapping("cart_delete.do")
	public String delete(int c_idx) {
		int res = cart_dao.delete(c_idx);

		return "redirect:cart_list.do";
	}

	// 장바구니에 항목 추가
	@RequestMapping("cart_insert.do")
	public String insert(CartVO vo) {
		cart_dao.insert(vo);
		// 중복 상품인지 조회
		CartVO cartvo = new CartVO();
		cartvo.setIdx(vo.getIdx());
		cartvo.setM_idx(vo.getM_idx());

		CartVO resVo = cart_dao.selectOne(cartvo);
		String result = "no";
		if (resVo == null) {
			result = "yes";
			// 상품을 장바구니에 등록
			cart_dao.insert(cartvo);
		}
		return "redirect:cart_list.do";
	}

	// 장바구니 수량 수정
	@RequestMapping("cart_update.do")
	public String update_cnt(CartVO vo, Model model) {
		cart_dao.update_cnt(vo);

		// 파라미터로 받은 값 vo 형태로 저장
		CartVO resvo = new CartVO();
		resvo.setC_idx(vo.getC_idx());
		resvo.setC_cnt(vo.getC_cnt());

		cart_dao.update_cnt(vo);

		// 현재 접속한 회원의 장바구니 목록 조회 (1 : 회원번호(m_idx))
		List<CartVO> list = cart_dao.select(1);

		// 장바구니 총 계 (1 : 회원번호(m_idx))
		int total_amount = cart_dao.selectTotalAmount(1);

		// 바인딩
		model.addAttribute("list", list);
		model.addAttribute("total", total_amount);

		// 포워딩
		return "redirect:cart_list.do";
	}

}
