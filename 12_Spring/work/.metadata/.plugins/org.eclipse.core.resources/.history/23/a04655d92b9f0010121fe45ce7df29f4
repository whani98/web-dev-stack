@charset "UTF-8";

* {
	margin: 0;
	padding: 0;
}
div {
	margin: auto;
}

table {
	border: 2px solid #ccc;
	width: 700px;
	margin-top: 30px;
	margin-bottom: 10px;
	box-shadow: 3px 3px 3px #ccc;
	padding: 5px;
	
}

#content {
	height: 200px;
	background-color: #ccc;
	text-align: left;
	padding: 5px;
}

#name, #regdate, #password{
	background-color: white;
}

#content textarea{
	width: 100%;
	height: 90%;
}
