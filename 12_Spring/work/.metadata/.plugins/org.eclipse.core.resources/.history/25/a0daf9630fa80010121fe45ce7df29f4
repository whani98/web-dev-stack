package controller;

import java.io.File;
import java.io.IOException;
import java.util.Iterator;
import java.util.List;
import java.util.Map;

import javax.servlet.ServletContext;
import javax.servlet.http.HttpServletRequest;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.util.MultiValueMap;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.multipart.MultipartFile;

import dao.ProductDAO;
import vo.ProductVO;

@Controller
public class ProductController {

	@Autowired
	ServletContext app;

	ProductDAO product_dao;

	public void setProduct_dao(ProductDAO product_dao) {
		this.product_dao = product_dao;
	}

	// 상품 리스트
	@RequestMapping(value = { "/", "list.do" })
	public String selectList(String category, Model model) {
		if (category == null || category.isEmpty()) { // null 값이거나 비어있으면
			category = "com001"; // 강제로 com001로 잡기
		}
		List<ProductVO> list = product_dao.selectList(category);

		// System.out.println("카테고리" + category);
		model.addAttribute("list", list); // 바인딩
		// null --> list.do
		// empty --> list.do?

		return "product/product_list"; // 포워딩
	}

	// 상품 등록 페이지로 이동
	@RequestMapping("product_insertform.do")
	public String insertForm() {
		return "product/product_insert";
	}

	// 상품 등록
	@RequestMapping("product_insert.do")
	public String insert(ProductVO vo, HttpServletRequest request) throws Exception {
		// 상대 경로 지정
		String webPath = "/resources/images/";
		// 절대 경로 지정
		String savePath = app.getRealPath(webPath);
		System.out.println(savePath);

		// 작은 사진
		// 업로드된 파일의 정보
		MultipartFile photo1 = vo.getPhoto1();

		// 파일이 없는 경우
		String filename1 = "no_file";

		// 업로드를 위한 파일이 있으면
		if (!photo1.isEmpty()) {

			// 업로드된 파일의 실제 파일명
			filename1 = photo1.getOriginalFilename();

			// 저장할 파일 경로
			File saveFile = new File(savePath, filename1);

			// 경로 중에서 존재하지 않는게 있으면
			if (!saveFile.exists()) {
				saveFile.mkdirs(); // 폴더 만들기
			} else {
				// 동일한 파일명이 존재한다면 현재 시간을 붙여 중복 방지
				long time = System.currentTimeMillis();
				filename1 = String.format("%d_%s", time, filename1);
				saveFile = new File(savePath, filename1);
			}
			photo1.transferTo(saveFile);
		}
		// 큰 사진
		// 업로드된 파일의 정보
		MultipartFile photo2 = vo.getPhoto2();

		// 파일이 없는 경우
		String filename2 = "no_file";
		// 업로드를 위한 파일이 있으면
		if (!photo2.isEmpty()) {

			// 업로드된 파일의 실제 파일명
			filename2 = photo2.getOriginalFilename();

			// 저장할 파일 경로
			File saveFile = new File(savePath, filename2);

			// 경로 중에서 존재하지 않는게 있으면
			if (!saveFile.exists()) {
				saveFile.mkdirs(); // 폴더 만들기
			} else {
				// 동일한 파일명이 존재한다면 현재 시간을 붙여 중복 방지
				long time = System.currentTimeMillis();
				filename2 = String.format("%d_%s", time, filename2);
				saveFile = new File(savePath, filename2);
			}
			photo2.transferTo(saveFile);
		}
		// 사진 정보 vo에 저장
		vo.setP_image_s(filename1);
		vo.setP_image_l(filename2);

		// 상품정보 DB로 보내기
		product_dao.insert(vo);

		return "redirect:list.do?category=" + vo.getCategory();
	}

	// 상품 삭제
	@RequestMapping("product_delete.do")
	@ResponseBody
	public String delete(int idx) {

		ProductVO vo = product_dao.selectOne(idx);

		int res = product_dao.delete(idx);
		String result = "no";
		if (res == 1) {
			result = "yes";

			if (!vo.getP_image_s().equals("no_file")) {
				String webPath = "/resources/images";
				String savePath = app.getRealPath(webPath);

				String p_image_s = savePath + vo.getP_image_s();

				File file = new File(p_image_s);
				if (file.exists()) {
					file.delete();
				}
			}
			if (!vo.getP_image_l().equals("no_file")) {
				String webPath = "/resources/images";
				String savePath = app.getRealPath(webPath);

				String p_image_l = savePath + vo.getP_image_l();

				File file = new File(p_image_l);
				if (file.exists()) {
					file.delete();
				}
			}
			return result;
		}
		return result;
	}

	// 상품 정보 수정페이지로 이동
	@RequestMapping("product_updateform.do")
	public String updateForm(int idx, Model model) {

		ProductVO vo = product_dao.selectOne(idx);
		model.addAttribute("vo", vo);

		return "product/product_update";
	}

	// 상품 정보 수정
	@RequestMapping("product_update.do")
	public String update(ProductVO vo) throws Exception {

		String webPath = "resources/images/";
		String savePath = app.getRealPath(webPath);
		
		MultipartFile photo1 = vo.getPhoto1();
		MultipartFile photo2 = vo.getPhoto2();
		
		String filename1 = vo.getP_image_s();
		String filename2 = vo.getP_image_l();
		if(photo1 != null && !photo1.isEmpty()) {
			filename1 = photo1.getOriginalFilename();
			File file = new File(savePath, filename1);
			photo1.transferTo(file);
		}
		
		if(photo2 != null && !photo2.isEmpty()) {
			filename2 = photo1.getOriginalFilename();
			File file = new File(savePath, filename2);
			photo1.transferTo(file);
		}
		product_dao.update(vo);

		return "redirect:list.do";
	}

	// 상품 상세 조회
	@RequestMapping("product_detail.do")
	public String detail(int idx, Model model) {

		ProductVO vo = product_dao.selectOne(idx);
		model.addAttribute("vo", vo);

		return "product/product_detail";
	}
}
