package controller;

import java.util.Iterator;
import java.util.List;
import java.util.Map;

import javax.servlet.ServletContext;
import javax.servlet.http.HttpServletRequest;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.util.MultiValueMap;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.multipart.MultipartRequest;

import dao.ProductDAO;
import vo.ProductVO;

@Controller
public class ProductController {

	ProductDAO product_dao;

	public void setProduct_dao(ProductDAO product_dao) {
		this.product_dao = product_dao;
	}

	// 상품 리스트
	@RequestMapping("list.do")
	public String selectList(String category, Model model) {
		List<ProductVO> list = product_dao.selectList(category);

		// System.out.println("카테고리" + category);
		model.addAttribute("list", list); // 바인딩
		// null --> list.do
		// empty --> list.do?
		if (category == null || category.isEmpty()) { // null 값이거나 비어있으면
			category = "com001"; // 강제로 com001로 잡기
		}
		return "product/product_list"; // 포워딩
	}

	// 상품 등록 페이지로 이동
	@RequestMapping("product_insertform.do")
	public String insertForm() {
		return "product/product_insert";
	}

	// 상품 등록
	@RequestMapping("product_insert.do")
	public String insert(ProductVO vo, HttpServletRequest request) {
		// 저장 위치 지정
		String path = "/product/resources/images/";

		// 리퀘스트로 객체화
		// 절대경로 가져옴
		// 최대 업로드 용량
		// int max_size = 1024 * 1024 * 100; // 약 100MB

		// MultipartRequest mr = new MultipartRequest(request, path, max_size, "utf-8");

		product_dao.insert(vo);

		return "redirect:list.do";
	}

	// 상품 삭제
	@RequestMapping("product_delete.do")
	@ResponseBody
	public String delete(int idx) {

		int res = product_dao.delete(idx);
		String result = "no";
		if (res == 1) {
			result = "yes";
			return result;
		}
		return result;
	}

	// 상품 정보 수정페이지로 이동
	@RequestMapping("product_updateform.do")
	public String updateForm(int idx, Model model) {

		ProductVO vo = product_dao.selectOne(idx);
		model.addAttribute("vo", vo);

		return "product/product_update";
	}

	// 상품 정보 수정
	@RequestMapping("product_update.do")
	public String update(ProductVO vo) {

		product_dao.update(vo);

		return "redirect:list.do";
	}

	// 상품 상세 조회
	@RequestMapping("product_detail.do")
	public String detail(int idx, Model model) {

		ProductVO vo = product_dao.selectOne(idx);
		model.addAttribute("vo", vo);

		return "product/product_detail";
	}
}
