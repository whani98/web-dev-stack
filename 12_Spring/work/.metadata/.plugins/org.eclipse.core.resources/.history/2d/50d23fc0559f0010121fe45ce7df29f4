package com.kh.fileupload;

import java.io.File;
import java.io.IOException;

import javax.servlet.ServletContext;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpSession;

import org.apache.ibatis.session.SqlSession;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.multipart.MultipartFile;

import vo.PhotoVO;

@Controller
public class FileuploadController {
	// @Autowired로 쓸 수 있는 것은 아래 4가지
	@Autowired
	ServletContext app;
	
//	@Autowired
//	HttpServletRequest request;
//	
//	@Autowired
//	SqlSession sqlSession;
//	
//	@Autowired
//	HttpSession session;
	
	@RequestMapping(value= {"/", "/insertform.do"})
	public String insert_form() {
		return "insert_form";
	}
	
	@RequestMapping("/upload.do")
	public String upload(PhotoVO vo, Model model) {
		
		// 임의 경로 지정
		//String savePath = "c:/myupload";
		// 상대경로 지정
		String webPath = "/resources/upload/"; 
		// 절대경로 지정 - 수시로 백업 필요
		String savePath = app.getRealPath(webPath);
		// System.out.println("절대경로" + savePath);
		
		// 업로드된 파일의 정보
		MultipartFile photo = vo.getPhoto();
		
		// 파일 고르기 전 기본값
		String filename = "no_file";
		
		// 업로드를 위한 파일이 존재한다면
		if(!photo.isEmpty()) { // 파일이 있으면!
			
			// 업로드된 파일의 실제 파일명
			filename = photo.getOriginalFilename();
			
			// 저장할 파일경로
			File saveFile = new File(savePath, filename);
			if(!saveFile.exists()) {// 경로 중에서 존재하지 않는게 있으면
				// 없는 파일을 물리적으로 파일 만들기 
				// mkdirs() : 다수의 폴더 만들기 // mkdir() : 하나의 폴더 만들기
				saveFile.mkdirs(); // 폴더 만들기
			} else {
				// 동일한 파일명이 존재한다면 현재 시간을 붙여서 중복을 방지
				long time = System.currentTimeMillis();
				filename = String.format("%d_%s", time, filename);
				saveFile = new File(savePath, filename);
			}
			// photo.transferTo(saveFile); 예외처리 -> try/catch -> 이미치로 업로드
			try {
				photo.transferTo(saveFile); // 이름이 일치하면 폴더로된 파일을 실제 파일형식으로 정보를 교체
				
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
		// 파일 이름 갱신
		vo.setFilename(filename);
		
		// vo로 바인딩
		model.addAttribute("vo", vo);
		return "";
	}
}
