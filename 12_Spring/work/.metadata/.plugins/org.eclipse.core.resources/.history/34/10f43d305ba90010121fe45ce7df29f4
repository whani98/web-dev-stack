@charset "UTF-8";

* {
	padding: 0;
	margin: 0;
}

form {
	margin-left: auto;
	margin-right: auto;
	width: 300px;
	padding: 30px;
	border-radius: 10px;
	margin-top: 250px;
	background-color: #E1EEBC;
}

input {
	color: green;
	border-radius: 10px;
	padding: 5px;
	margin: 5px;
}

input[type=text] {
	outline: none;
	height: 20px;
	border: 1px solid #ccc;
}

input[type=button] {
	border-style: none;
	
}