package controller;

import java.io.File;
import java.io.IOException;
import java.util.List;

import javax.servlet.ServletContext;
import javax.servlet.http.HttpServletRequest;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.multipart.MultipartFile;

import dao.VisitDAO;
import vo.VisitVO;

@Controller
public class VisitController {

	// ip 받을 때 사용
	// @Autowired : 메모리 할당 안받아도 쉽게 쓸 수 있음
	// ServletContext app; (프로젝트의 정보를 가지는 객체, 절대 경로 받을 때 사용), SqlSession sqlSession,
	// HttpServletRequest request;
	// 이 세가지가 Autowired 달고 쉽게 쓸 수 있음
	@Autowired
	HttpServletRequest request;

	@Autowired
	ServletContext app;

	VisitDAO visit_dao;

	public void setVisit_dao(VisitDAO visit_dao) {

		this.visit_dao = visit_dao;
	}

	// 방명록 조회
	@RequestMapping(value = { "/", "list.do" })
	public String selectList(Model model, VisitVO vo) {

		// selectList 호출해서 list 형태로 가져오기
		List<VisitVO> list = visit_dao.selectList();
		model.addAttribute("list", list); // 바인딩

		return "visit/visit_list"; // 포워딩
	}

	// 글쓰기 버튼 -> 방명록 폼 페이지 이동
	@RequestMapping("visit_insertform.do")
	public String insertForm() {

		return "visit/visit_insert";
	}

	// 글 등록
	@RequestMapping("visit_insert.do")
	public String insert(VisitVO vo) {
		
		// 상대 경로 지정
		String webPath = "/resources/upload/";
		// 절대 경로 지정
		String savePath = app.getRealPath(webPath);
		System.out.println(savePath);

		// 업로드된 파일의 정보
		MultipartFile photo = vo.getPhoto();

		// 파일 고르기 전 기본값
		String filename = "no_file";

		// 업로드를 위한 파일이 있으면
		if (!photo.isEmpty()) {

			// 업로드된 파일의 실제 파일명
			filename = photo.getOriginalFilename();

			// 저장할 파일 경로
			File saveFile = new File(savePath, filename);
			
			// 경로 중에서 존재하지 않는게 있으면
			if (!saveFile.exists()) {
				saveFile.mkdirs(); // 폴더 만들기
			} else {
				// 동일한 파일명이 존재한다면 현재 시간을 붙여 중복 방지
				long time = System.currentTimeMillis();
				filename = String.format("%d_%s", time, filename);
				saveFile = new File(savePath, filename);
			}
			try {
				photo.transferTo(saveFile);
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
		// 파일 이름 갱신
		vo.setFilename(filename);
		// ip 받기
		String ip = request.getRemoteAddr();
		vo.setIp(ip);

		visit_dao.insert(vo);

		return "redirect:list.do";
	}

	// 방명록 삭제
	@RequestMapping("visit_delete.do")
	@ResponseBody
	public String delete(int idx) {

		// 게시글 하나 조회
		VisitVO vo = visit_dao.selectOne(idx);
		if(!vo.getFilename().equals("no_file")) { // 이미지가 등록되어있는 경우
			
		}
		int res = visit_dao.delete(idx);
		String result = "no";

		if (res == 1) {
			result = "yes"; // 삭제 성공

			return result;
		}
		return result;
	}

	// 수정할 방명록 조회
	@RequestMapping("visit_updateform.do")
	public String updateForm(int idx, Model model) {

		VisitVO vo = visit_dao.selectOne(idx);
		model.addAttribute("vo", vo); // 바인딩

		return "visit/visit_update"; // 포워딩
	}

	// 방명록 수정
	@RequestMapping("visit_update.do")
	public String update(VisitVO vo) {

		// 수정 시 ip 변경 가능성 있으니 새로 받기
		String ip = request.getRemoteAddr();
		vo.setIp(ip);

		visit_dao.update(vo);

		return "redirect:list.do";
	}

	// 비밀번호 일치 -> 삭제
	@RequestMapping("visit_pwdCheck1.do")
	public String pwdCheck1(VisitVO visitVo) {

		visit_dao.pwdCheck(visitVo);

		return "redirect:visit_updateform.do";
	}

}
