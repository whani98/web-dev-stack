<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="c">

	<!-- 회원별 장바구니 조회 -->
	<select id="cart_list" resultType="cart" parameterType="int">
		select *
		from cart_view where m_idx = #{m_idx}
	</select>
</mapper>












