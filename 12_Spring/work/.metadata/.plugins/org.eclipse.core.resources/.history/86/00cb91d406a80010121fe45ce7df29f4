<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
    <%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>제품 정보 수정</title>
<script src="/product/resources/js/httpRequest.js"></script>
<script>
function update(f){
	// 유효성 체크
	f.method="post";
	f.action = "product_update.do";
	f.submit();
}
</script>
</head>
<body>
<jsp:include page="../index.jsp" />

	<form method="post" enctype="multipart/form-data">
		<table border="1" align="center" width="600">
		<tr>
				<td colspan="2"><b>수정페이지</b></td>
			<tr>
				<td>제품 카테고리</td>
				<td><select name="category" value="${vo.category}">
						<option>카테고리 선택</option>
						<option value="com001">컴퓨터</option>
						<option value="ele002">생활가전</option>
						<option value="sp003">스포츠</option>
				</select></td>
			</tr>
			<tr>
				<td>제품 코드</td>
				<td><input name="p_num" value="${vo.p_num}"/></td>
			</tr>
			<tr>
				<td>제품명</td>
				<td><input name="p_name" value="${vo.p_name}" /></td>
			</tr>
			<tr>
				<td>제조사</td>
				<td><input name="p_company" value="${vo.p_company}"/></td>
			</tr>
			<tr>
				<td>제품 가격</td>
				<td><input name="p_price" value="${vo.p_price}"/></td>
			</tr>
			<tr>
				<td>할인 가격</td>
				<td><input name="p_saleprice" value="${vo.p_saleprice}"/></td>
			</tr>
			<tr>
				<td colspan="2">제품 설명</td>
			</tr>
			<tr>
				<td colspan="2"><textarea rows="5" cols="80"
						style="resize: none" name="p_content">${vo.p_content}</textarea></td>
			</tr>

			<tr>
				<td>작은 사진(썸네일)</td>
				<td><input type="file" name="photo1" value="${vo.p_image_s}"></td>
			</tr>
			<tr>
				<td>큰 사진(상세보기)</td>
				<td><input type="file" name="photo2" value="${vo.p_image_l}"></td>
			</tr>
			<tr>
				<td colspan="2"><input type="button" value="수정" onClick="update(this.form);" />
				<input type="button" value="취소" onClick="location.href='list.do'" /></td>
			</tr>
		</table>
	</form>
</body>
</html>