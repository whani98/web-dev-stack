<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="p">
	<!-- 제품 리스트 -->
	<select id="product_list" parameterType="String"
		resultType="pro">
		select * from product where category = #{category}
	</select>

	<!-- 제품 등록 -->
	<insert id="pro_insert" parameterType="pro">
		insert into product
		values(seq_pro_idx.nextVal, #{category}, #{p_num}, #{p_name},
		#{p_company}, #{p_price},
		#{p_saleprice}, #{p_image_s}, #{p_image_l},
		#{p_content}, sysdate)
	</insert>

	<!-- 제품 삭제 -->
	<delete id="product_delete" parameterType="int">
		delete from product where idx = #{idx}
	</delete>
	
	<!-- 수정할 제품 조회 -->
	<select id="product_selectOne" parameterType="int" resultType="pro">
		select * from product where idx =#{idx}
	</select>
	
	<!-- 제품 정보 수정 -->
</mapper>












