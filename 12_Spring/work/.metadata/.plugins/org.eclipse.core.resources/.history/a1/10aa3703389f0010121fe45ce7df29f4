@charset "UTF-8";

* {
	margin: 0;
	padding: 0;
}
h1{
	color : #555;
}
table {
	border: 2px solid #cdc;
	width: 700px;
	margin-top: 30px;
	margin-bottom: 10px;
	box-shadow: 3px 3px 3px #ccc;
	padding: 5px;
	
}

#content {
	height: 200px;
	background-color: #cdc;
	text-align: left;
	padding: 5px;
}

#name, #regdate, #password{
	background-color: white;
}

#content textarea{
	width: 100%;
	height: 90%;
}
input{
	background: #cdc;
	border-style: none;
	border-radius: 2px;
	padding: 5px;
	color: green;
}
input[type=button]{
	
}
input[type=button]:hover{
	background: green;

	color: #cdc;
}
textarea{
	resize: none;
}
