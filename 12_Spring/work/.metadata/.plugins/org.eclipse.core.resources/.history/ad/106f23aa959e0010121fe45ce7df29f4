<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="p">
	<!-- 상품 리스트 -->
	<select id="product_list" parameterType="String" resultType="pro">
		select * from product 
		<where>
		<if test="category != null">
            category = #{category}
        </if>
		
        <if test="category == null">
            category = 'com001'
        </if>
    </where>
	</select>
</mapper>












