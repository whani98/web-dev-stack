@charset "UTF-8";

* {
	padding: 0;
	margin: 0;
}

/* 브라우저 배경색 */
body{
	background:#E1EEBC29;
}

/* 이메일 인증 box */
form {
	margin-left: auto;
	margin-right: auto; /* 중앙정렬 */
	width: 300px;
	height:150px;
	padding: 15px 30px 30px 30px; 
	border-radius : 10px;
	margin-top: 250px;
	background-color: #E1EEBC;
	display: flex;
	flex-direction: column;
}

/* 이메일 인증 글씨 스타일 */
h2{
	color: #90C67C;
	margin-bottom: 18px;
}

/* input text,button 공통 스타일 */
input {
	border-style: none;
	border-radius: 10px;
	padding: 5px;
	margin: 5px;
}

/* input text 스타일 */
input[type=text] {
	outline: none;
	height: 20px;
	border: 1px solid #ccc;
}

/* input button 스타일 */
input[type=button] {
	width: 100px;
	color: white;
	background-color: #90C67C;
	cursor: pointer;
}

form .input{
	flex-direction: row;
}

form #mail_check_warn {
	align-self: center;
	margin: auto;
}