<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="m">
	<!-- 회원 리스트 -->
	<select id="member_list" resultType="mem">
		select * from member order by desc
	</select>
	
	<!-- 회원 등록 -->
	<insert id="member_insert" parameterType="mem">
		insert into member
		values (seq_member_idx.nextVal, #{name}, #{id}, #{pwd}, #{email}, #{addr})
	</insert>
	
	<!-- 회원 삭제 -->
	<delete id="member_delete" parameterType="int">
		delete from member where idx = #{idx}
	</delete>
	
	<!-- 수정할 회원 조회 -->
	<select id="member_one" parameterType="int" resultType="mem">
		select * from member where idx = #{idx}
	</select>
	
	<!-- 회원 정보 수정 -->
	<update id="member_update" parameterType="mem">
		update member set name = #{name}, id = #{id}, pwd = #{pwd}, email = #{email}, addr = #{addr} where idx = #{idx}
	</update>
	
	

</mapper>












