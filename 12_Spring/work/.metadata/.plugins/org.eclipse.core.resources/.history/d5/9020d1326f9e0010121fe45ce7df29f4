<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="v">
	<!-- 방명록 리스트 -->
	<select id="visit_list" resultType="vst">
		select * from visit order by idx desc
	</select>
	
	<!-- 방명록 추가 -->
	<insert id="visit_insert" parameterType="vst">
		insert into visit values (seq_visit_idx.nextVal, '일길동', '내가 1등 했어요', '1111', '192.1.1.1', sysdate)
	</insert>


</mapper>












