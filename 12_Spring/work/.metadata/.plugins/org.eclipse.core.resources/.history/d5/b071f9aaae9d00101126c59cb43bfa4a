package dao;

import java.util.List;

import org.apache.ibatis.session.SqlSession;

import util.PwdBcrypt;
import vo.MemberVO;

public class MemberDAO {

	SqlSession sqlSession;
	public void setSqlSession(SqlSession sqlSession) {
		this.sqlSession = sqlSession;
	}
	
	// 회원 조회
	public List<MemberVO> selectList(){
		List<MemberVO> list = sqlSession.selectList("m.member_list");
		return list;
	}
	
	// 회원 등록
	public int insert(MemberVO vo) {
		
		// 비밀번호 암호화
		PwdBcrypt pbc = new PwdBcrypt();
		String encodePwd = pbc.encodingPwd(vo.getPwd());
		
		vo.setPwd(encodePwd);
		
		int res = sqlSession.insert(vo);
		
		return res;
	}
	
	// 회원 삭제
	public int delete(int idx) {
		int res = sqlSession.delete("m.member_delete", idx);
		return res;
	}
	
	// 수정할 회원 조회
	public MemberVO selectOne(int idx) {
		MemberVO vo = sqlSession.selectOne("m.member_one", idx);
		return vo;
	}
	
	// 회원 수정
	public int update(MemberVO vo) {
		int res = sqlSession.insert("m.member_update", vo);
		return res;
	}
	

}
