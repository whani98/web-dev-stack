<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>방명록 추가</title>
<link rel="stylesheet" href="/visit/resources/css/visit_style.css"></link>
<script src="/visit/resources/js/httpRequest.js"></script>
<script>
	function send(f) {

		let content = f.content.value;
		if (content == "") {
			alert("글 작성 필수입니다.");
			return;
		}

		let name = f.name.value.trim();
		if (name == "") {
			alert("작성자를 입력해주세요.");
			return;
		}

		let pwd = f.pwd.value.trim();
		if (pwd == "") {
			alert("비밀번호를 입력해주세요.");
			return;
		}
		f.method = "post";
		f.action = "visit_insert.do";
		f.submit(); // controller로 보냄
	}
</script>
</head>
<body>
	<div align="center">
		<h1>~방명록 작성~</h1>
		<form>
			<table>
				<tr>
					<td id="content">방명록 작성 : <textarea name="content" wrap="on"></textarea></td>
				</tr>
				<tr>
					<td id="name">작성자 : <input name="name"></td>
				</tr>
				<tr>
					<td id="password">비밀번호 : <input type="password" name="pwd">
					</td>
				</tr>
			</table>
			<input type="button" value="등록" onClick="send(this.form);"> 
			<input type="button" value="취소" onclick="location.href='list.do'">
		</form>

	</div>
</body>
</html>